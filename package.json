{
  "name": "study-planner-mcp",
  "version": "0.1.0",
  "description": "Study planner MCP for exam study schedules, spaced repetition dates, pomodoro plans and assignment milestones. Works offline.",
  "type": "module",
  "main": "build/src/index.js",
  "bin": {
    "study-planner-mcp": "build/src/index.js"
  },
  "files": [
    "build/src",
    "README.md",
    "llms.txt",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node -e \"require('fs').chmodSync('build/src/index.js', 0o755)\"",
    "test": "vitest run",
    "start": "node build/src/index.js",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "study planner mcp",
    "study planner",
    "study-planner-mcp",
    "mcp",
    "mcp server",
    "mcp-server",
    "model context protocol",
    "model-context-protocol",
    "exam study plan",
    "spaced repetition",
    "pomodoro",
    "assignment milestones",
    "student",
    "education",
    "offline"
  ],
  "author": "AnonymousOnyx22",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnonymousOnyx22/study-planner-mcp.git"
  },
  "homepage": "https://github.com/AnonymousOnyx22/study-planner-mcp#readme",
  "bugs": {
    "url": "https://github.com/AnonymousOnyx22/study-planner-mcp/issues"
  },
  "mcpName": "io.github.AnonymousOnyx22/study-planner-mcp",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
